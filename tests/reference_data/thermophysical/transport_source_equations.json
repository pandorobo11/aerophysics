          0.0268142,
          0.3177838,
          -11.3155513
        ],
        [
          0.044929,
          -0.0826158,
          -9.2019475
        ],
        [
          -0.02201,
          1.01,
          -13.42
        ],
        [
          -0.041372,
          1.3293,
          -15.016
        ]
      ],
      "mole_fractions_before_normalization": [
        0.78084,
        0.209476,
        0.00934,
        0.000314
      ],
      "molar_masses_kg_mol": [
        0.0280134,
        0.0319988,
        0.039948,
        0.0440095
