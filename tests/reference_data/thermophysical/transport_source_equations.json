{
  "role": "direct reproduction of published equations and constants in a separate implementation",
  "command": "python docs/scripts/build_transport_reference.py",
  "models": {
    "Sutherland viscosity": {
      "constants": {
        "mu0_Pa_s": 1.7894e-05,
        "T0_K": 288.15,
        "S_K": 110.4
      },
      "source": "Sutherland (1893); normalization from USSA 1976"
    },
    "Keyes viscosity": {
      "constants": {
        "coefficient": 1.488e-06,
        "A_K": 122.1,
        "B_K": 5.0
